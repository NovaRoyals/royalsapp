{
  "expo": {
    "name": "ROYALS",
    "slug": "royalsapp",
    "version": "1.0.0",
    "description": "The digital home of Nova Royals Athletic Club.",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "royals",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "org.novaroyals.royals"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#151310",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.novaroyals.royals"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#151310",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F36A21"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7be0d1e0-ca15-4728-a5d5-50c04e3c6b44"
      }
    },
    "owner": "nova-royals"
  }
}
