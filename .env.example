# Safe client-visible values only. Do not add a service-role or secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep demo until a server-side payment provider integration is configured.
EXPO_PUBLIC_PAYMENT_MODE=demo

# Set to 1 to show Interaction Lab and Roy Lab in a review build. Local development shows them without this.
EXPO_PUBLIC_REVIEWER_TOOLS=
